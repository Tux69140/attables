{
  "name": "attables",
  "private": false,
  "version": "0.3.0",
  "description": "Carnet d'invitations personnel hors ligne : foyers, allergies alimentaires et mémoire anti-doublon des plats.",
  "license": "GPL-3.0-or-later",
  "author": "Stéphane MICHEL <stephane@biovibralyon.fr>",
  "homepage": "https://github.com/Tux69140/attables#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tux69140/attables.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:demo": "vite build --mode demo --base /demo/ --outDir dist-site/demo --emptyOutDir",
    "site:dev": "vite --config site/vite.config.ts",
    "site:captures": "node scripts/captures-site.mjs",
    "site:build": "vite build --config site/vite.config.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"site/**/*.test.ts\"",
    "tauri": "tauri",
    "icones": "node --import tsx scripts/importer-icones.ts"
  },
  "dependencies": {
    "@fontsource/baumans": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
